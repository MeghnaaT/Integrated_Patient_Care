# =============================================================================
# .env.example — Integrated Patient Care Management System
# =============================================================================
# Copy this file to .env and fill in your local values.
# NEVER commit your real .env file to version control.
# =============================================================================

# ----- Database (MySQL) -------------------------------------------------------
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_db

# ----- Flask ------------------------------------------------------------------
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# 'development' enables debug mode and hot-reload
# 'production' enforces secure cookies and disables debug
FLASK_ENV=development

# Optional: override the default port (default is 5000)
# PORT=5000
